soong_namespace { }

cc_library {
    name: "bootctrl.jr510",
    visibility: ["//visibility:public"],
    defaults: ["bootctrl_hal_defaults"],
    static_libs: [
        "libgptutils",
        "libotautil",
        "libvintf", 
        "libhidl-gen-utils",
        "libc++fs"
    ],
    shared_libs: [
        "android.hardware.boot@1.0",
        "android.hardware.boot@1.1",
        "android.hardware.boot@1.2",
        "libhidlbase",
        "libutils"
    ]
}
