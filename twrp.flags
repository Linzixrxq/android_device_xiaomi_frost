# Mount Points
/boot               emmc        /dev/block/by-name/boot                   flags=display="Boot";backup=1;flashimg=1;slotselect
/dtbo               emmc        /dev/block/by-name/dtbo                   flags=display="DTBO";backup=1;flashimg=1;slotselect
/vbmeta             emmc        /dev/block/by-name/vbmeta                 flags=display="VBMeta";backup=1;flashimg=1;slotselect
/vbmeta_system      emmc        /dev/block/by-name/vbmeta_system          flags=display="VBMeta System";backup=1;flashimg=1;slotselect

/metadata           ext4        /dev/block/by-name/metadata               flags=display="Metadata"
/persist            ext4        /dev/block/by-name/persist                flags=display="Persist";backup=1
/data               f2fs        /dev/block/by-name/userdata               flags=display="Userdata";backup=1;wipeingui
/misc               emmc        /dev/block/by-name/misc                   flags=display="Misc"
/cust               ext4        /dev/block/by-name/cust                   flags=display="Cust";backup=1;flashimg=1

# Внешние накопители
/external_sd        vfat        /dev/block/mmcblk1p1 /dev/block/mmcblk1   flags=display="MicroSD";storage;wipeingui;removable
/usb_otg            vfat        /dev/block/sda1 /dev/block/sda            flags=display="USB OTG";storage;wipeingui;removable

# Модем и Прошивки
/firmware           vfat        /dev/block/by-name/modem                  flags=display="Firmware";mounttodecrypt;slotselect
/dsp                vfat        /dev/block/by-name/dsp                    flags=display="DSP";slotselect
/bt_firmware        vfat        /dev/block/by-name/bluetooth              flags=display="Bluetooth";slotselect
